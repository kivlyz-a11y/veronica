#--------------------------------------------------------------------
# SI VERONIKA - PRODUCTION ENVIRONMENT TEMPLATE FOR COOLIFY
# Pengadilan Agama Penajam
#--------------------------------------------------------------------

# Environment (production / development / testing)
CI_ENVIRONMENT = production

# URL Aplikasi (Ganti dengan domain / FQDN Coolify Anda, wajib diakhiri dengan '/')
# Contoh: https://veronika.pa-penajam.go.id/ atau https://app.coolify-domain.com/
app.baseURL = 'https://veronika.domainanda.com/'
app.indexPage = ''
app.defaultLocale = 'id'
app.negotiateLocale = false
app.appTimezone = 'Asia/Makassar'

# Database Configuration (Sesuaikan dengan Database Service di Coolify)
database.default.hostname = db
database.default.database = si_veronika
database.default.username = veronika_user
database.default.password = veronika_secret_password
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# Auto Migrate Database saat kontainer start (true / false)
AUTO_MIGRATE = true

# WhatsApp Gateway Provider Configuration (mock / waha / http)
WHATSAPP_PROVIDER = waha
WHATSAPP_API_URL = http://36.95.108.50:3000
WHATSAPP_API_KEY = secret123
WHATSAPP_SESSION = test
WHATSAPP_SENDER = 6285389705146
WHATSAPP_TIMEOUT = 30
WHATSAPP_MAX_RETRY = 3

# File Upload Settings (dalam KB)
FILES_MAX_SIZE = 5120
FILES_ALLOWED_TYPES = pdf,jpg,jpeg,png,doc,docx,xls,xlsx

# Session Configuration
SESSION_DRIVER = CodeIgniter\Session\Handlers\FileHandler
SESSION_SAVE_PATH = writable/session
SESSION_EXPIRATION = 7200
